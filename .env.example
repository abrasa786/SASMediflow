# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of this app (used in email confirmation links). Set to your Vercel URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Testing only: skip email verification on sign-up (never in production)
AUTO_CONFIRM_EMAILS=false
# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Branding & custom domains (optional) ──
# Hosts that are "the platform itself" (comma separated). A clinic's own domain shows that clinic's page at "/".
PLATFORM_HOSTS=
# Optional: add each clinic's custom domain to the Vercel project automatically (so HTTPS is issued for it).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
