# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of this app (used in email confirmation links). Set to your Vercel URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Testing only: skip email verification on sign-up (never in production)
AUTO_CONFIRM_EMAILS=false
# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Branding & custom domains (optional) ──
# Hosts that are "the platform itself" (comma separated). A clinic's own domain shows that clinic's page at "/".
PLATFORM_HOSTS=
# Optional: add each clinic's custom domain to the Vercel project automatically (so HTTPS is issued for it).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── AI trust layer ──
# 32+ random characters. Encrypts every stored AI question and answer (AES-256-GCM). Keep it secret; losing it makes old history unreadable.
AI_DATA_KEY=
# Random string. Vercel cron sends it to /api/ai/purge, which deletes history older than each clinic's retention.
CRON_SECRET=

# Optional: your platform domain, so every clinic also gets www.<clinic>.<domain> and <clinic>.<domain> (needs wildcard DNS *.<domain> pointing at Vercel)
ROOT_DOMAIN=

# Optional: your own main address (e.g. app.mediflow.in). Anyone opening the *.vercel.app address is redirected here.
CANONICAL_HOST=

# WhatsApp two-way chat (patients message the clinic). In Meta's developer console set the webhook to https://<your-address>/api/whatsapp/webhook,
# use the verify token below, and subscribe to "messages". WHATSAPP_APP_SECRET is your Meta app's secret (used to check every request is really from WhatsApp).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional approved template for recall messages (variables: first name, clinic, detail)
WHATSAPP_TEMPLATE_RECALL_PATIENT=
